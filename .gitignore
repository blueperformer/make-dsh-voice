# Dependencies. The runtime needs none of its own; pnpm installs this package
# into a profile, it does not build it.
node_modules/

# Secrets. The plugin stores its API key in the harness' own settings document
# ($DSH_HOME/settings.yaml), never in the repository — but a .env must never land
# here either, because synthesize.py will happily read one when run standalone.
.env
.env.*
!.env.example

# Synthesized audio, when synthesize.py is run standalone from the checkout.
output/

# Python bytecode caches. Any `python -m py_compile` or import of synthesize.py
# leaves one here, and it is machine-specific compiled output.
__pycache__/
*.py[cod]

# Scratch directory verify.mjs uses while exercising the audio store. It removes
# it itself, so this only matters if a run was killed midway.
.verify-tmp/

# Editor / OS cruft
.DS_Store
Thumbs.db
*.log

# NOTE: lib/client.js IS committed on purpose. It is generated by build.mjs, but
# the client module registry reads it straight off disk at install time, so
# shipping it is what makes `dsh plugin add` work with no build step.
# CI asserts that the committed copy matches a fresh build.
